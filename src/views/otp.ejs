<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Poppins:wght@400;500;600&display=swap');

        body {
            background: radial-gradient(circle at 10% 20%, rgb(43, 198, 172) 0%, rgb(43, 220, 210) 90%);
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
        }

        .otp-container {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            max-width: 440px;
            width: 100%;
            padding: 2.5rem 2rem;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.5);
            text-align: center;
        }

        .otp-container img {
            max-width: 150px;
            height: auto;
            margin-bottom: 1.5rem;
        }

        h2 {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            color: #1a3038;
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
        }

        p.subtitle {
            color: #607d8b;
            font-size: 0.95rem;
            margin-bottom: 2rem;
        }

        .otp-inputs input {
            width: 52px;
            height: 58px;
            font-size: 24px;
            font-weight: 600;
            text-align: center;
            margin: 0 6px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            background-color: #f8fafc;
            color: #1e293b;
        }

        .otp-inputs input:focus {
            border-color: #2bc6ac;
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(43, 198, 172, 0.2);
            outline: none;
        }

        .timer-section {
            margin-top: 1.5rem;
            font-size: 0.95rem;
            color: #64748b;
            min-height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #timer-text {
            color: #64748b;
            font-weight: 500;
        }

        #timer {
            font-weight: 700;
            color: #0f8076;
            margin-left: 4px;
        }

        #resend {
            color: #11998e;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 6px 16px;
            border-radius: 12px;
            background-color: rgba(43, 198, 172, 0.1);
            display: inline-block;
        }

        #resend:hover {
            color: #ffffff;
            background-color: #11998e;
            box-shadow: 0 4px 12px rgba(17, 153, 142, 0.25);
            transform: translateY(-1px);
        }

        #resend:active {
            transform: translateY(0);
        }

        .btn-confirm {
            background: linear-gradient(135deg, #11998e 0%, #2bc6ac 100%);
            border: none;
            color: white;
            font-weight: 600;
            padding: 12px;
            font-size: 1.1rem;
            border-radius: 12px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(43, 198, 172, 0.3);
            margin-top: 1.5rem;
            width: 100%;
        }

        .btn-confirm:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(43, 198, 172, 0.4);
        }

        .btn-confirm:active {
            transform: translateY(0);
        }

        .alert-custom {
            margin-top: 1.5rem;
            padding: 12px;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        @media (max-width: 576px) {
            .otp-inputs input {
                width: 42px;
                height: 48px;
                font-size: 20px;
                margin: 0 3px;
            }
        }
    </style>
</head>

<body>

    <div class="otp-container">
        <img src="/images/logo.png" alt="BrainElevate Logo" class="img-fluid">
        <h2>Enter OTP Code</h2>
        <p class="subtitle">Please enter the 6-digit verification code sent to your email.</p>
        
        <form action="/verify-otp" method="POST">
            <div class="otp-inputs d-flex justify-content-center my-3">
                <!-- pattern and inputmode ensure numeric keypads on mobile browsers -->
                <input type="text" name="otp1" maxlength="1" pattern="[0-9]" inputmode="numeric" required autofocus autocomplete="off">
                <input type="text" name="otp2" maxlength="1" pattern="[0-9]" inputmode="numeric" required autocomplete="off">
                <input type="text" name="otp3" maxlength="1" pattern="[0-9]" inputmode="numeric" required autocomplete="off">
                <input type="text" name="otp4" maxlength="1" pattern="[0-9]" inputmode="numeric" required autocomplete="off">
                <input type="text" name="otp5" maxlength="1" pattern="[0-9]" inputmode="numeric" required autocomplete="off">
                <input type="text" name="otp6" maxlength="1" pattern="[0-9]" inputmode="numeric" required autocomplete="off">
            </div>

            <div class="timer-section">
                <span id="timer-text" style="display: none;">Resend code in <span id="timer"></span></span>
                <a id="resend" onclick="resendOTP()" style="display: none;">Resend Code</a>
            </div>

            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <div class="alert alert-danger alert-custom">
                    <%= errorMessage %>
                </div>
            <% } %>

            <div>
                <button class="btn btn-confirm">Confirm Code</button>
            </div>
        </form>
    </div>

   <script>

let remainingTime =
    Number("<%= typeof remainingTime !== 'undefined' ? remainingTime : 0 %>");

if (isNaN(remainingTime) || remainingTime < 0) {
    remainingTime = 0;
}

let otpExpiresAt = Date.now() + remainingTime;

let countdown = null;

const resendLink = document.getElementById("resend");
const timerText = document.getElementById("timer-text");
const timerSpan = document.getElementById("timer");

function updateUI() {

    const secondsLeft = Math.max(
        0,
        Math.floor((otpExpiresAt - Date.now()) / 1000)
    );

    if (secondsLeft <= 0) {

        clearInterval(countdown);

        timerText.style.display = "none";

        resendLink.style.display = "inline-block";
        resendLink.style.pointerEvents = "auto";
        resendLink.style.opacity = "1";

        return;
    }

    resendLink.style.display = "none";
    resendLink.style.pointerEvents = "none";

    timerText.style.display = "inline-block";

    const minutes = Math.floor(secondsLeft / 60);
    const seconds = secondsLeft % 60;

    timerSpan.textContent =
        `${minutes}:${seconds < 10 ? "0" : ""}${seconds}`;
}

function startTimer() {

    clearInterval(countdown);

    updateUI();

    if (otpExpiresAt > Date.now()) {
        countdown = setInterval(updateUI, 1000);
    }
}

startTimer();

async function resendOTP() {

    if (resendLink.style.display === "none") {
        return;
    }

    resendLink.style.pointerEvents = "none";
    resendLink.textContent = "Sending...";

    try {

        const response = await fetch("/resend-otp", {
            method: "POST"
        });

        const data = await response.json();

        if (!data.success) {

            resendLink.textContent = "Resend Code";
            resendLink.style.pointerEvents = "auto";

            alert(data.message);

            return;
        }

        otpExpiresAt =
            Date.now() + data.remainingTime;

        resendLink.textContent = "Resend Code";

        startTimer();

    } catch (err) {

        console.error(err);

        resendLink.textContent = "Resend Code";
        resendLink.style.pointerEvents = "auto";

        alert("Failed to resend OTP");
    }
}

const inputs =
    document.querySelectorAll('.otp-inputs input');

inputs.forEach((input, index) => {

    input.addEventListener('input', () => {

        input.value =
            input.value.replace(/[^0-9]/g, '');

        if (
            input.value &&
            index < inputs.length - 1
        ) {
            inputs[index + 1].focus();
        }
    });

    input.addEventListener('keydown', (e) => {

        if (
            e.key === 'Backspace' &&
            input.value === '' &&
            index > 0
        ) {
            inputs[index - 1].focus();
        }
    });

    input.addEventListener('paste', (e) => {

        const pasted =
            e.clipboardData.getData('text');

        if (
            /^\d{6}$/.test(pasted)
        ) {

            pasted.split('').forEach(
                (digit, i) => {
                    inputs[i].value = digit;
                }
            );

            inputs[5].focus();

            e.preventDefault();
        }
    });
});

</script>
</body>

</html>