<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= user.fullName %> | Edit Profile
    </title>


    <link rel="stylesheet" href="/css/header.css">

    <link rel="stylesheet" href="/css/editProfile.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">



</head>

<body>

    <%- include('partials/header') %>

        <div class="edit-profile-container">
            <h4 style="margin-bottom:1.5rem;">Account Settings</h4>

            <!-- Account Settings -->
            <section class="account-settings">
                <div class="profile-section">

                    <!-- Profile Image Card -->
                    <div class="profile-image">

                        <div class="settings-card">


                            <!-- VIEW MODE -->
                            <div id="imageView">
                                <div class="image-wrapper">
                                    <img src="<%= user.profilepic || '/images/default-avatar.png' %>" alt="User"
                                        referrerpolicy="no-referrer">
                                </div>
                            </div>


                            <button id="imgEditBtn" type="button" class="edit-text-btn" onclick="toggleImageEdit()">
                                + Upload Photo
                            </button>


                            <!-- EDIT MODE -->
                            <div id="imageEdit" style="display:none;">
                                <div class="image-wrapper">
                                    <img src="<%= user.profilepic || '/images/default-avatar.png' %>" alt="User"
                                        referrerpolicy="no-referrer">

                                    <form action="/profile/upload-photo/<%= user._id %>" method="POST"
                                        enctype="multipart/form-data">
                                        <label for="photo" class="overlay">
                                            <i class="bi bi-upload"></i>
                                            <span>Upload Photo</span>
                                        </label>
                                        <input id="photo" name="profile" type="file" hidden
                                            onchange="if (this.files.length) { this.form.submit(); this.value = null; }">
                                    </form>
                                </div>

                                <button class="btn-cancel" onclick="toggleImageEdit()">Cancel</button>
                                <small>Image size should be under 1MB and ratio 1:1</small>
                            </div>

                        </div>

                    </div>
                    <!-- ========================= -->
                    <!-- ACCOUNT DETAILS (View/Edit Toggle) -->
                    <!-- ========================= -->

                    <div class="account-details">
                        <div class="settings-card">

                            <!-- Title + Edit Button -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 style="margin:0;">Account Details</h4>
                                <button id="infoEditBtn" type="button" class="edit-text-btn" onclick="toggleInfo()">
                                    <strong>Edit</strong>
                                </button>
                            </div>

                            <!-- VIEW MODE -->
                            <div id="infoView">

                                <p><strong>Name:</strong>
                                    <%= user.fullName %>
                                </p>
                                <p><strong>Location:</strong>
                                    <%= user.location || '––' %>
                                </p>
                                <p><strong>Contact:</strong>
                                    <%= `${user.countryCode } ${user.contactNumber }`|| '––' %>
                                </p>
                                <p><strong>Gender:</strong>
                                    <%= user.gender || '––' %>
                                </p>

                            </div>

                            <!-- EDIT MODE -->
                            <form action="/profile/<%= user._id %>/update" method="POST" id="infoEdit"
                                style="display:none;" class="profile-form">

                                <div>
                                    <label>Full name</label>
                                    <input type="text" name="fullName"
                                        value="<%= (formData && formData.fullName) || user.fullName||'' %>">
                                    <% if (fieldErrors?.invalidName ) { %>
                                        <div class="error">
                                            <p>
                                                <%= fieldErrors.invalidName %>
                                            </p>
                                        </div>
                                        <% } %>
                                </div>


                                <div></div>

                                <div>
                                    <label>Country</label>
                                    <select name="country" id="country" class="countryCode"></select>

                                </div>

                                <div></div>

                                <div>
                                    <label>Contact Number</label>
                                    <input type="hidden" id="iso" name="iso">
                                    <div class="d-flex">
                                        <input type="text" id="dialCode" name="code" class="dialform" readonly>
                                        <input type="text" id="phone" name="phone" class="dialform-opposite">
                                    </div>

                                    <% if (fieldErrors?.invalidNum ) { %>
                                        <div class="error">
                                            <p>
                                                <%= fieldErrors.invalidNum %>
                                            </p>
                                        </div>
                                        <% } %>
                                </div>


                                <div>
                                    <label>Gender</label>
                                    <div class="gender-group">
                                        <label><input type="radio" name="gender" value="Male" <%=((formData?.gender ||
                                                user.gender)==='Male' ) ? 'checked' : '' %>> Male</label>

                                        <label><input type="radio" name="gender" value="Female" <%=((formData?.gender
                                                ||user.gender)==='Female' ) ? 'checked' : '' %>>Female</label>

                                        <label><input type="radio" name="gender" value="Others" <%=((formData?.gender
                                                ||user.gender)==='Others' ) ? 'checked' : '' %>> Others</label>


                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-end">
                                    <button type="button" class="btn-cancel mt-2 "
                                        onclick="toggleInfo()">Cancel</button>
                                    <button type="submit" class="btn-save mt-2">Save Changes</button>


                                </div>


                            </form>

                        </div>

                    </div>

            </section>

            <!-- Change Password -->
            <section class="change-password">
                <h3 style="margin-bottom:1.5rem;">Change password</h3>
                <form action="/profile/<%= user._id %>/updatePassword" method="POST">
                    <label>Current Password</label>

                    <input type="password" name="currentPassword" placeholder="Password"
                        class="form-control change-password-input">
                    <p style="font-size:0.85rem; color:#888; margin-top:0.5rem;">(OTP verification required)</p>

                    <button type="submit" class=" btn-change mt-3">Change Password</button>


                    
                    <a href="#" class="delete-link" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                        Delete Account
                    </a>

                </form>
                <%- include("partials/deleteModal") %>


            </section>

        </div>


        <%- include("partials/flashalerts") %>


            <!-- Footer -->
            <%- include('partials/footer') %>

</body>
<script>
  <% if (fieldErrors?.openDeleteModal) { %>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = new bootstrap.Modal(document.getElementById('deleteAccountModal'));
            modal.show();
        });
  <% } %>
</script>

<script>
        document.addEventListener("DOMContentLoaded", () => {
            const hasFormData = <%= formData ? "true" : "false" %>;

            if (hasFormData) {
                toggleInfo();
            }
        });
</script>


<script>
    function toggleInfo() {
        const view = document.getElementById("infoView");
        const edit = document.getElementById("infoEdit");
        const editBtn = document.getElementById("infoEditBtn");
        const isView = view.style.display !== "none";
        view.style.display = isView ? "none" : "block";
        edit.style.display = isView ? "block" : "none";

        //Hide/show the Edit button
        editBtn.style.display = isView ? "none" : "inline-block";
    }

    function toggleImageEdit() {
        const imgView = document.getElementById("imageView");
        const imgEdit = document.getElementById("imageEdit");
        const imgEditBtn = document.getElementById("imgEditBtn");
        const isView = imgView.style.display !== "none";
        imgView.style.display = isView ? "none" : "block";
        imgEdit.style.display = isView ? "block" : "none";
        //Hide/show the Edit button
        imgEditBtn.style.display = isView ? "none" : "inline-block";
    }
</script>





<!-- fetching contries , country code and iso for validation -->
<script>
    document.addEventListener("DOMContentLoaded", () => {

        const selectCountry = document.querySelector("#country");
        const dialCodeInput = document.querySelector("#dialCode");
        const phoneInput = document.querySelector("#phone");

        const savedCountry = "<%= user.location || (formData && formData.country) || '' %>";
        const savedDialCode = "<%= user.countryCode || (formData && formData.code) || '' %>";
        const savedPhone = "<%= (formData && formData.phone)||user.contactNumber || '' %>";

        fetch('https://restcountries.com/v3.1/all?fields=name,idd,cca2')
            .then(res => res.json())
            .then(data => {

                // Sort country list
                data.sort((a, b) => a.name.common.localeCompare(b.name.common));

                data.forEach(country => {
                    if (!country.idd || !country.idd.root) return;

                    const root = country.idd.root;
                    const suffix = country.idd.suffixes ? country.idd.suffixes[0] : "";
                    const dialCode = root + suffix;

                    const option = document.createElement("option");

                    // VALUE = country name (easy for pre-select)
                    option.value = country.name.common;

                    // ⭐ store dial code in data-dial=""
                    option.dataset.dial = dialCode;
                    option.dataset.iso = country.cca2;   // 🇮🇳 IN, 🇺🇸 US, etc.

                    option.textContent = country.name.common;

                    // pre-select country
                    if (country.name.common === savedCountry) {
                        option.selected = true;
                        document.querySelector("#iso").value = country.cca2; // set saved ISO


                    }

                    selectCountry.appendChild(option);
                });

                // Load saved dial code + phone (edit mode)
                if (savedDialCode) dialCodeInput.value = savedDialCode;
                if (savedPhone) phoneInput.value = savedPhone;
            });

        // When user changes country
        selectCountry.addEventListener("change", () => {
            const selectedOption = selectCountry.options[selectCountry.selectedIndex];
            const dialCode = selectedOption.dataset.dial;
            const isoCode = selectedOption.dataset.iso;  // "IN"


            dialCodeInput.value = dialCode;
            document.querySelector("#iso").value = isoCode;  //  send ISO to backend
        });

    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>


</html>