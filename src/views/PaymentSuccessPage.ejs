<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Successful</title>

  <!-- Lottie Player -->
  <script src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.8.5/dist/dotlottie-wc.js" type="module"></script>

  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: "Inter", sans-serif;
      background: #ffffff;
      color: #222;
      display: flex;
      justify-content: center;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      text-align: center;
    }

    .container {
      max-width: 420px;
      width: 100%;
      padding: 20px;
      margin-top: 10px;
    }

    h1 {
      font-weight: 600;
      margin: 20px 0 10px;
      font-size: 26px;
    }

    p {
      color: #555;
      font-size: 16px;
      margin-bottom: 20px;
    }

    .summary-box {
      background: #fafafa;
      border: 1px solid #eee;
      padding: 18px 20px;
      border-radius: 10px;
      margin: 25px 0;
      text-align: left;
    }

    .summary-row {
      margin-bottom: 12px;
      font-size: 15px;
      color: #444;
    }

    .summary-row strong {
      float: right;
      color: #222;
    }

    .item-list {
      margin: 10px 0;
      padding-left: 10px;
    }

    a.button {
      text-decoration: none;
      display: inline-block;
      padding: 12px 22px;
      background: #111;
      color: #fff;
      border-radius: 6px;
      font-size: 15px;
      transition: 0.2s ease;
      margin-top: 15px;
    }

    a.button:hover {
      background: #333;
    }

    .fade-in {
      animation: fadeIn 1.1s ease forwards;
      opacity: 0;
    }

    @keyframes fadeIn {
      to {
        opacity: 1;
      }
    }
  </style>
</head>

<body>

  <div class="container fade-in">

    <!-- Success Animation -->
    <dotlottie-wc 
      src="https://lottie.host/b62b140f-1d1f-49fb-ad82-87c1b87f5c78/C4aFF7zFWa.lottie" 
      background="transparent"
      speed="1"
      style="width: 220px; height: 220px; margin:auto;" 
      autoplay>
    </dotlottie-wc>

    <h1>Payment Successful</h1>
    <p>Your order has been confirmed. Thank you for your payment!</p>

    <!-- Order Summary -->
    <div class="summary-box">
      <div class="summary-row">
        Order ID:
        <strong><%= order._id %></strong>
      </div>

      <div class="summary-row">
        Total Amount:
        <strong>₹<%= order.totalAmount %></strong>
      </div>
      <div class="summary-row">
        Transaction Id:
        <strong><%= order.transactionId %></strong>
      </div>
    </div>

    <a href="/" class="button">Go to Home</a>
    <a href="/order/<%= order._id %>/receipt" class="button" style="background:#007bff; margin-left:10px;">
  Download Receipt
</a>

  </div>

</body>

</html>
