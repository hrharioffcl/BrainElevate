<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add new Chapter</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="d-flex" style="background-color: black;">

    <!-- Sidebar -->
    <%- include("partials/superadminsidebar") %>

        <!-- Main Content -->
        <div class="main-content flex-grow-1 p-4 text-dark " style="background-color:#F8FAFC;">
                            <div class="container">
                                <div class="row justify-content-center">
                                    <div class="col-md-6"> <!-- change 6 to 4 or 5 for narrower -->

                                        <div class="page-header d-flex justify-content-between align-items-center ">
                                            <h2>Add New Chapter</h2>
                                            <a href="/admin/coursesmangement/update/<%= course._id %>"
                                                class="btn btn-danger">Cancel</a>
                                        </div>

                                        <form action="/admin/courses/<%= course._id %>/chapters/add" method="POST"   enctype="multipart/form-data"

                                            class="mt-4">

                                            <div class="mb-3">
                                                <label class="form-label">Chapter Title</label>
                                                <input type="text" class="form-control" name="title">
                                            </div>
<div class="mb-3">
    <label class="form-label">Upload Lecture Video</label>

    <input
        type="file"
        class="form-control"
        id="lectureVideoInput"
        name="lectureVideo"
        accept="video/*">
        <input
    type="hidden"
    id="videoDuration"
    name="videoDuration">

    <div id="videoPreviewContainer"
         class="mt-3"
         style="display:none;">

        <label class="form-label">
            Video Preview
        </label>

        <video
            id="videoPreview"
            controls
            style="
                width:100%;
                max-height:350px;
                border-radius:8px;
            ">
        </video>

    </div>
</div>

                                            <div class="mb-3">
                                                <label class="form-label">Lecture Description</label>
                                                <textarea class="form-control" name="lectureDescription"
                                                    rows="4"></textarea>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Lecture Notes</label>
                                                <textarea class="form-control" name="lectureNotes" rows="4"></textarea>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Upload PDF</label>
                                                <input type="file" class="form-control" name="lecturePdf"
                                                    accept="application/pdf,.doc,.docx,.txt">
                                            </div>

                                            <div class="row mb-3">
                                                <!-- Status Dropdown -->
                                                <!-- <div class="col-md-6">
                                                    <label class="form-label">Status</label>
                                                    <select class="form-select" name="status">
                                                        <option value="draft" selected>Draft</option>
                                                        <option value="pendingApproval">Pending Approval</option>
                                                        <option value="published">Published</option>
                                                    </select>
                                                </div> -->

                                                <!-- Order Input -->
                                                <div class="col-md-2">
                                                    <label class="form-label">Order</label>
                                                    <input type="number" class="form-control form-control-sm"
                                                        name="order" maxlength="3" style="width:80px;">
                                                </div>
                                            </div>


                                            <div class="d-flex justify-content-end">
                                                <button type="submit" class="btn btn-dark">Save Chapter</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
        </div>
          <%- include("partials/flashalerts") %>

</body>
<script>
const videoInput =
    document.getElementById(
        "lectureVideoInput"
    );

const videoPreview =
    document.getElementById(
        "videoPreview"
    );

const previewContainer =
    document.getElementById(
        "videoPreviewContainer"
    );

const durationInput =
    document.getElementById(
        "videoDuration"
    );

videoInput.addEventListener(
    "change",
    function(){

        const file =
            this.files[0];

        if(!file) return;

        const videoURL =
            URL.createObjectURL(file);

        videoPreview.src =
            videoURL;

        previewContainer.style.display =
            "block";

        videoPreview.onloadedmetadata =
    function(){

        durationInput.value =
            Math.floor(
                videoPreview.duration
            );

        URL.revokeObjectURL(
            videoURL
        );

        console.log(
            "Duration:",
            durationInput.value
        );
    };
    }
);
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>



</html>