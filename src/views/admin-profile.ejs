<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/adminProfile.css">
   
</head>

<body class="d-flex" style="background-color:black;">

    <!-- Sidebar -->
  
<% if(admin.profileCompleted){ %>

    <% if(admin.role==="contributor"){ %>

        <%- include("partials/contributorSideBar") %>

    <% } else { %>

        <%- include("partials/managerSidebar") %>

    <% } %>

<% } %>
                        <!-- Main Content -->
                        <div
    class="main-content flex-grow-1 p-4"
    style="<%= !admin.profileCompleted ? 'margin-left:0;' : '' %>">

                            <h3 class="text-white mb-4">
                                My Profile
                            </h3>
<% if(!admin.profileCompleted){ %>

<div class="alert alert-warning mb-4">

    <h5 class="mb-2">
        Complete Your Profile
    </h5>

    <p class="mb-0">
        Please complete your contact information before accessing the dashboard.
    </p>

</div>

<% } %>
                            <div class="row">

                                <!-- Profile Image -->
                                <div class="col-lg-4 mb-4">

                                    <div class="card profile-card text-center p-4">

                                        <img src="<%= admin?.profilePic?.url || '/images/defaultdp.svg' %>"
                                            alt="Profile Picture" class="profile-preview mx-auto">

                                        <h5 class="mt-3">
                                            <%= admin.fullName %>
                                        </h5>

                                        <p class="text-info text-capitalize">
                                            <%= admin.role %>
                                        </p>

                                        <form action="/admin/profile/upload-photo" method="POST"
                                            enctype="multipart/form-data">

                                            <input type="file" name="profilePic" accept="image/*"
                                                class="form-control mt-3">

                                            <button type="submit" class="btn upload-btn mt-3">

                                                Upload Photo

                                            </button>

                                        </form>

                                    </div>

                                </div>

                                <!-- Profile Details -->
                                <div class="col-lg-8">

                                    <div class="card profile-card p-4">

                                        <h5 class="mb-4">
                                            Account Information
                                        </h5>

                                        <form action="/admin/profile/update" method="POST">

                                            <!-- Read Only -->

                                            <div class="mb-3">
                                                <label>Full Name</label>

                                                <input type="text" class="form-control" value="<%= admin.fullName %>"
                                                    readonly>
                                            </div>

                                            <div class="mb-3">
                                                <label>Email</label>

                                                <input type="email" class="form-control" value="<%= admin.email %>"
                                                    readonly>
                                            </div>

                                            <div class="mb-3">
                                                <label>Role</label>

                                                <input type="text" class="form-control" value="<%= admin.role %>"
                                                    readonly>
                                            </div>

                                            <div class="mb-3">
                                                <label>Joined Date</label>

                                                <input type="text" class="form-control"
                                                    value="<%= new Date(admin.createdAt).toLocaleDateString() %>"
                                                    readonly>
                                            </div>

                                            <hr>

                                            <h5 class="mb-3">
                                                Personal Information
                                            </h5>

                                            <div class="mb-3">
                                                <label>Contact Number</label>

                                                <input type="text" class="form-control" name="contactNumber"
                                                    value="<%= formData.contactNumber || admin.contactNumber || '' %>">
                                            </div>

                                            <div class="mb-3">
                                                <label>Gender</label>

                                                <select name="gender" class="form-select">

                                                    <option value="Male" <%= (formData.gender || admin.gender) === "Male" ? "selected" : "" %>>
                                                        Male
                                                    </option>

                                                    <option value="Female" <%= (formData.gender || admin.gender)==="Female" ? "selected" : ""
                                                        %>>
                                                        Female
                                                    </option>

                                                    <option value="Other"<%= (formData.gender || admin.gender)==="Other" ? "selected" : "" %>
                                                        >
                                                        Other
                                                    </option>

                                                </select>
                                            </div>

                                           <div class="mb-3">
    <label>Address</label>

    <textarea
        class="form-control"
        rows="4"
        name="address"><%= formData.address || admin.address || '' %></textarea>
</div>

                                            <button type="submit" class="btn upload-btn">

                                                Save Changes

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <%- include("partials/flashalerts") %>

                            <script
                                src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>