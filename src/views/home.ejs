<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BrainElevate</title>
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/home.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chilanka&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
</head>

<body>

  <main>
    <%- include('partials/header') %>

    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h2 style="font-family: 'K2D', sans-serif; color: #fdffff;">Welcome, <%= fullName %> 👋</h2><br>
        <h1 class="typewriter" style="font-family: 'K2D', sans-serif;color: #fff;">CLICK.LEARN. GROW.</h1>
        <p>Learn from real-world experts from around the globe. Get courses from ₹299.</p>
        <div class="d-flex justify-content-center">
          <a class="btn btn-danger rounded-pill p-6 w-50" href="/courses">Get Started</a>
        </div>
      </div>
    </section>

    <!-- Category Section -->
    <section class="category-section">
      <div class="container my-2">
        <h2 class="fw-bold text-dark">Browse in Brain Elevate</h2>
        <p class="text-dark">Browse learning content designed to help your business or career.</p>

        <div class="row g-3">
          <% categories.forEach(cat => { %>
            <div class="col-md-3 col-sm-6">
              <a href="/courses?categories=<%= cat._id %>" class="text-decoration-none">
                <div class="card shadow-sm rounded-3 text-center p-3 h-100 category-card">
                  <div class="mb-2">
                    <i class="bi bi-journal-bookmark" style="font-size: 2rem;"></i>
                  </div>
                  <h6 class="fw-bold">
                    <%= cat.name %>
                  </h6>
                  <h6>
                    <%= cat.coursecount %> Courses <br>
                    <i class="bi bi-arrow-right"></i>
                  </h6>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- Latest Courses Section -->
    <section>
      <div class="container my-5">
        <h2 class="fw-bold">Our Latest Courses</h2>
        <p class="text-muted">Recommended for you</p>
        <hr>

        <div class="row g-4">
          <% courses.forEach(course => { %>
            <div class="col-md-4 col-lg-3 d-flex">
              <div class="card shadow-sm border-0 d-flex flex-column w-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-start">
                  <div>
                    <% if (course.price === 0) { %>
                      <span>
                        <i class="badge bi-lightning-charge-fill fs-6 start-0 m-2 text-warning"> Free</i>
                      </span>
                    <% } %>
                  </div>
                </div>

                <!-- Course Image -->
                <a href="/courses/<%= course.slug %>" class="text-decoration-none w-100 d-flex">
                  <img src="<%= course.thumbnail.url %>" class="card-img-top" alt="<%= course.title %>">
                </a>

                <!-- Card Body -->
                <div class="card-body d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="bg-category text-dark p-1" style="font-size: small;">
                      <%= course.category.name %>
                    </span>
                    <span>
                      <p class="fw-bold mb-0 text-dark">₹<%= course.price %></p>
                    </span>
                  </div>

                  <hr>

                  <!-- Dedicated Name Space -->
                  <a href="/courses/<%= course.slug %>" class="text-decoration-none w-100 d-flex">
                    <h6 class="fw-bold text-dark course-name mb-3">
                      <%= course.name %>
                    </h6>
                  </a>

                  <!-- Footer -->
                  <div class="mt-auto d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                      <span class="fw-bold me-2">
                        <%= course.rating %>
                      </span>
                      <span class="text-warning">
                        <% for (let i = 1; i <= 5; i++) { %>
                          <% if (i <= Math.floor(course.rating)) { %>
                            <i class="bi bi-star-fill"></i>
                          <% } else if (i - course.rating < 1) { %>
                            <i class="bi bi-star-half"></i>
                          <% } else { %>
                            <i class="bi bi-star"></i>
                          <% } %>
                        <% } %>
                      </span>
                    </div>
                    <span class="text-danger">
                      <%= course.duration %>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- Courses Under 500 Section -->
    <section>
      <div class="container my-5">
        <h2 class="fw-bold">Courses Under 500</h2>
        <p class="text-muted">Recommended for you</p>
        <hr>

        <div class="row g-4">
          <% lowpricecourse.forEach(course => { %>
            <div class="col-md-4 col-lg-3 d-flex">
              <div class="card shadow-sm border-0 d-flex flex-column w-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-start">
                  <div>
                    <% if (course.price === 0) { %>
                      <span>
                        <i class="badge bi-lightning-charge-fill fs-6 start-0 m-2 text-warning"> Free</i>
                      </span>
                    <% } %>
                  </div>
                </div>

                <a href="/courses/<%= course.slug %>" class="text-decoration-none w-100 d-flex">
                  <img src="<%= course.thumbnail.url %>" class="card-img-top" alt="<%= course.title %>">
                </a>

                <!-- Card Body -->
                <div class="card-body d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="bg-category text-dark p-1" style="font-size: small;">
                      <%= course.category.name %>
                    </span>
                    <span>
                      <p class="fw-bold mb-0 text-dark">₹<%= course.price %></p>
                    </span>
                  </div>

                  <hr>

                  <a href="/courses/<%= course.slug %>" class="text-decoration-none w-100 d-flex">
                    <h6 class="fw-bold text-dark course-name mb-3">
                      <%= course.name %>
                    </h6>
                  </a>

                  <!-- Footer -->
                  <div class="mt-auto d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                      <span class="fw-bold me-2">
                        <%= course.rating %>
                      </span>
                      <span class="text-warning">
                        <% for (let i = 1; i <= 5; i++) { %>
                          <% if (i <= Math.floor(course.rating)) { %>
                            <i class="bi bi-star-fill"></i>
                          <% } else if (i - course.rating < 1) { %>
                            <i class="bi bi-star-half"></i>
                          <% } else { %>
                            <i class="bi bi-star"></i>
                          <% } %>
                        <% } %>
                      </span>
                    </div>
                    <span class="text-danger">
                      <%= course.duration %>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- Free Courses Section -->
    <section>
      <div class="container my-5">
        <h2 class="fw-bold">Try Our Free Courses</h2>
        <p class="text-muted">Recommended for you</p>
        <hr>

        <div class="row g-4">
          <% freeCourses.forEach(course => { %>
            <div class="col-md-4 col-lg-3 d-flex">
              <div class="card shadow-sm border-0 d-flex flex-column w-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-start">
                  <div>
                    <% if (course.price === 0) { %>
                      <span>
                        <i class="badge bi-lightning-charge-fill fs-6 start-0 m-2 text-warning"> Free</i>
                      </span>
                    <% } %>
                  </div>
                </div>

                <a href="/courses/<%= course.slug %>" class="text-decoration-none w-100 d-flex">
                  <img src="<%= course.thumbnail.url %>" class="card-img-top" alt="<%= course.title %>">
                </a>

                <!-- Card Body -->
                <div class="card-body d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="bg-category text-dark p-1" style="font-size: small;">
                      <%= course.category.name %>
                    </span>
                    <span>
                      <p class="fw-bold mb-0 text-dark">₹<%= course.price %></p>
                    </span>
                  </div>

                  <hr>

                  <a href="/courses/<%= course.slug %>" class="text-decoration-none w-100 d-flex">
                    <h6 class="fw-bold text-dark course-name mb-3">
                      <%= course.name %>
                    </h6>
                  </a>

                  <!-- Footer -->
                  <div class="mt-auto d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                      <span class="fw-bold me-2">
                        <%= course.rating %>
                      </span>
                      <span class="text-warning">
                        <% for (let i = 1; i <= 5; i++) { %>
                          <% if (i <= Math.floor(course.rating)) { %>
                            <i class="bi bi-star-fill"></i>
                          <% } else if (i - course.rating < 1) { %>
                            <i class="bi bi-star-half"></i>
                          <% } else { %>
                            <i class="bi bi-star"></i>
                          <% } %>
                        <% } %>
                      </span>
                    </div>
                    <span class="text-danger">
                      <%= course.duration %>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- Continue Learning Slider Section -->
    <section class="continue-learning-section">
      <div class="container">
        <div class="section-header">
          <h2>Continue Learning</h2>
          <div class="slider-nav-btns">
            <button class="slider-nav-btn" id="slide-left" aria-label="Slide Left" disabled>
              <i class="bi bi-chevron-left"></i>
            </button>
            <button class="slider-nav-btn" id="slide-right" aria-label="Slide Right">
              <i class="bi bi-chevron-right"></i>
            </button>
          </div>
        </div>

        <div class="continue-learning-slider" id="learning-slider">
          <% continueLearning.forEach(course => { %>
            <a href="/course/<%= course.slug %>" class="course-card">
              <img src="<%= course.thumbnail %>" alt="<%= course.title %>">
              <h3><%= course.title %></h3>
              <p>
                <span><%= course.progress %>% completed</span>
              </p>
              <div class="progress-bar">
                <div class="progress-fill" style="width:<%= course.progress %>%"></div>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Slider functionality script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const slider = document.getElementById('learning-slider');
      const slideLeftBtn = document.getElementById('slide-left');
      const slideRightBtn = document.getElementById('slide-right');

      if (!slider || !slideLeftBtn || !slideRightBtn) return;

      function updateBtnState() {
        const scrollLeft = slider.scrollLeft;
        const maxScrollLeft = slider.scrollWidth - slider.clientWidth;

        slideLeftBtn.disabled = scrollLeft <= 1;
        slideRightBtn.disabled = scrollLeft >= maxScrollLeft - 1;
      }

      slideLeftBtn.addEventListener('click', function() {
        // Slide left by 1 card length + gap (300px card + 24px gap)
        slider.scrollBy({ left: -324, behavior: 'smooth' });
      });

      slideRightBtn.addEventListener('click', function() {
        // Slide right by 1 card length + gap (300px card + 24px gap)
        slider.scrollBy({ left: 324, behavior: 'smooth' });
      });

      slider.addEventListener('scroll', updateBtnState);
      window.addEventListener('resize', updateBtnState);

      // Run initial check and delayed checks for image loads
      setTimeout(updateBtnState, 200);
      setTimeout(updateBtnState, 1000);
    });
  </script>
</body>

</html>
