                            data-progress="<%= enrolled.progress %>">
                            <svg width="200" height="200">
                                <circle cx="60" cy="60" r="50" stroke="#eee" stroke-width="10" fill="none"></circle>

                                <circle class="animated-ring" cx="60" cy="60" r="50" stroke="#00C49A" stroke-width="10"
                                    fill="none" stroke-dasharray="314" stroke-dashoffset="314" stroke-linecap="round"
