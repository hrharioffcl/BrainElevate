<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>

    </title>
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/coursepage.css" />
        <link rel="stylesheet" href="/css/boughtCourse.css" />
</head>

<body>
    <!-- Navbar Partial -->
    <%- include('partials/header') %>

        <!-- MAIN WRAPPER -->
        <div class="course-page" style="margin: 0;">

            <!-- Header + Progress -->
            <div class=" row course-header-section m-0">
                <div class="col-12  col-md-8 course-title-block">
                    <h1><%= course.name %></h1>
                    <hr>
                    <p>
                       <%= course.details %>
                    </p>
                </div>

                <div class=" col-12  col-md-4 progress-block d-flex justify-content-end">
                  
 <%
  const circumference = 314;
  const targetOffset = circumference - (circumference * enrolled.progress / 100);
%>
<div class="progress-circle" data-offset="<%= targetOffset %>" data-progress="<%= enrolled.progress %>">
    <svg width="200" height="200">
        <circle cx="60" cy="60" r="50" stroke="#eee" stroke-width="10" fill="none"></circle>

        <circle class="animated-ring"
                cx="60" cy="60" r="50"
                stroke="#00C49A"
                stroke-width="10"
                fill="none"
                stroke-dasharray="314"
                stroke-dashoffset="314"
                stroke-linecap="round"
                transform="rotate(-90 60 60)">
        </circle>
    </svg>

    <div class="progress-text">
        <h3 id="progress-number">0%</h3>
        <p>Completed</p>
    </div>
</div>




                      
                    </div>
                </div>

            </div>
<div class="content-wrapper">
            <!-- Course Description -->
            <div class="course-description mt-3 pt-3">
                <h2>Course Description</h2>
                <p>
                    <%= course.description %>
                </p>
            </div>

            <!-- Chapters -->
            <!-- Chapters -->
<div class="chapters-section mt-4">
    <h2>Chapters</h2>

    <div class="row">

        <% chapters.forEach((chapter) => { %>
            <div class="col-12 col-md-4 mb-4">
                <div class="chapter-card p-3">

                    <div class="d-flex justify-content-between">
                        <h4>Chapter <%= chapter.order %> – <%= chapter.title %></h4>

                      

                    </div>

                    <p class="text-muted"><%= chapter.lectureDescription || "" %></p>

                    <a href="/course/<%= course._id %>/chapter/<%= chapter._id %>" class="btn btn-outline-dark">
                        View Chapter
                    </a>

                </div>
            </div>
        <% }) %>

    </div>
</div>



            </div>
        </div>
            <%- include("partials/flashalerts") %>

              
</body>
  <!-- Footer Partial -->
                <%- include('partials/footer') %>
  <script>
document.addEventListener("DOMContentLoaded", () => {
    const circleContainer = document.querySelector(".progress-circle");
    if (!circleContainer) return;

    const targetOffset = circleContainer.dataset.offset;
    const progressValue = parseInt(circleContainer.dataset.progress);
    const animatedRing = circleContainer.querySelector(".animated-ring");
    const numberElement = document.getElementById("progress-number");

    // Animate the circle
    animatedRing.style.strokeDashoffset = targetOffset;

    // Animate the number (0 → progressValue)
    let currentValue = 0;
    const duration = 1500;   // 1.5 seconds
    const frameRate = 20;    // update every 20 ms
    const increment = progressValue / (duration / frameRate);

    const counter = setInterval(() => {
        currentValue += increment;

        if (currentValue >= progressValue) {
            currentValue = progressValue;
            clearInterval(counter);
        }

        numberElement.textContent = Math.round(currentValue) + "%";
    }, frameRate);
});
</script>


</html>