            </div>

            <!-- Chapters -->
            <!-- Chapters -->
            <div class="chapters-section mt-4">
                <h2>Chapters</h2>

                <div class="row">

                    <% chapters.forEach((chapter)=> { %>
                        <div class="col-12 col-md-3 mb-4">
                            <a href="/profile/<%= user.fullName %>/myLearning/<%= course.slug %>/<%= enrolled._id %>/<%= chapter._id %>"
                                class="text-decoration-none">

                                <div class="chapter-card p-3">

                                    <div class="d-flex justify-content-between align-items-center">
                                        <h4 class="mb-1 text-white">
                                            <%= chapter.order %> . <%= chapter.title %>
                                        </h4>

                                        <!-- <% if (chapter.completed) { %>
                                            <span class="badge bg-success">Completed</span>
                                            <% } %> -->
                                    </div>



                                    <!-- Progress Bar -->
                                    <div class="progress mt-2" style="height: 10px;">
                                        <div class="progress-bar progressbaar text-dark " role="progressbar"
                                            style="width: <%= chapter.progressPercent %>%"
                                            aria-valuenow="<%= chapter.progressPercent %>" aria-valuemin="0"
                                            aria-valuemax="100">
                                            <!-- <strong> <%= chapter.progressPercent %> %</strong> -->
                                        </div>
                                    </div>

                                    <small class="text-white">
                                        <%= chapter.progressPercent %>% completed
                                    </small>

                                </div>
                            </a>
                        </div>
                        <% }) %>


                </div>
            </div>




            <!-- ADD REVIEW SECTION (STYLISH STAR RATING) -->
            <div class="reviews-section mt-5 pt-4 mb-5">
                <h2>Add a Review</h2>
                <hr>

                <div class="card review-card">
                    <div class="card-body">
                        <form action="/course/<%= course.name %>/review" method="POST">
                            <!-- course id -->`
                            <input type="hidden" name="courseId" value="<%= course._id %>">
                            <!-- Star Rating -->
                            <div class="mb-3">
                                <label class="form-label d-block">Your Rating</label>
                                <div class="star-rating">
                                    <input type="radio" id="star5" name="rating" value="5" required />
                                    <label for="star5" title="5 stars">★</label>

                                    <input type="radio" id="star4" name="rating" value="4" />
                                    <label for="star4" title="4 stars">★</label>

                                    <input type="radio" id="star3" name="rating" value="3" />
                                    <label for="star3" title="3 stars">★</label>

                                    <input type="radio" id="star2" name="rating" value="2" />
                                    <label for="star2" title="2 stars">★</label>

                                    <input type="radio" id="star1" name="rating" value="1" />
                                    <label for="star1" title="1 star">★</label>
                                </div>
                            </div>

                            <!-- Review Text -->
                            <div class="mb-3">

                                <label for="comment" class="form-label text-dark">
                                    <h6>Write a review</h6>
                                </label>
                                <textarea class="form-control" id="comment" name="comment" rows="4"
                                    placeholder="Share your experience..." required></textarea>
                            </div>
                            <!-- Review Title -->
                            <div class="mb-3">
                                <label for="title" class="form-label text-dark">
                                    <h6>Title your review (required)</h6>
                                </label>
                                <input type="text" class="form-control" id="title" name="title"
                                    placeholder="Whats most important to know?" maxlength="60" required>
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-dark rounded-pill px-4">Submit</button>
                            </div>
                    </div>
                    </form>
                </div>
            </div>
        </div>


        </div>
        </div>

        <%- include("partials/flashalerts") %>


</body>
<!-- Footer Partial -->
<%- include('partials/footer') %>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const circleContainer = document.querySelector(".progress-circle");
            if (!circleContainer) return;

            const targetOffset = circleContainer.dataset.offset;
            const progressValue = parseInt(circleContainer.dataset.progress);
            const animatedRing = circleContainer.querySelector(".animated-ring");
            const numberElement = document.getElementById("progress-number");

            // Animate the circle
            animatedRing.style.strokeDashoffset = targetOffset;

            // Animate the number (0 → progressValue)
            let currentValue = 0;
            const duration = 1500;   // 1.5 seconds
            const frameRate = 20;    // update every 20 ms
            const increment = progressValue / (duration / frameRate);

            const counter = setInterval(() => {
                currentValue += increment;

                if (currentValue >= progressValue) {
                    currentValue = progressValue;
                    clearInterval(counter);
                }

                numberElement.textContent = Math.round(currentValue) + "%";
            }, frameRate);
        });
    </script>

