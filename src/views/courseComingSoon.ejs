<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        <%= course.name %> | Coming Soon
    </title>

    <link rel="stylesheet" href="/css/header.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="/css/courseComingSoon.css" />
</head>

<body>

    <!-- Header -->
    <%- include("partials/header") %>

    <div class="coming-soon-wrapper">

        <div class="coming-card">

            <div class="icon-wrapper">
                <i class="fas fa-graduation-cap"></i>
            </div>

            <h1>
                <%= course.name %>
            </h1>

            <p class="subtitle">
                Course content is currently under development.
            </p>

            <p class="description">
                We’re preparing high-quality lessons, chapters,
                and resources for this course.
                Please check back soon.
            </p>

            <div class="course-meta">

                <div class="meta-item">
                    <i class="fas fa-user"></i>
                    <span>
                        <%= course.author %>
                    </span>
                </div>

                <div class="meta-item">
                    <i class="fas fa-clock"></i>
                    <span>
                        Coming Soon
                    </span>
                </div>

            </div>

            <div class="button-group">

                <a href="/profile/<%= user.fullName %>/myLearning"
                   class="btn back-btn">

                    <i class="fas fa-arrow-left"></i>
                    Back to My Learning

                </a>

                <a href="/"
                   class="btn home-btn">

                    <i class="fas fa-home"></i>
                    Go Home

                </a>

            </div>

        </div>

    </div>

    <!-- Footer -->
    <%- include("partials/footer") %>

</body>

</html>