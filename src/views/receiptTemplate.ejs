<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Receipt | <%= order._id %></title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <style>
    body {
      background: #f6fafb;
      font-family: "Helvetica", sans-serif;
      padding: 30px;
    }

    .receipt-card {
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
      border-top: 5px solid #4beada;
    }

    .brand-color {
      color: #4beada !important;
      text-decoration: underline;
    }

    .table thead {
      background: #e8fcff;
    }

    .table thead th {
      color: #148c9e !important;
    }

    .total-row {
      font-size: 1.2rem;
      font-weight: 700;
      border-top: 2px solid #4beada;
    }

    .logo {
      width: 120px;
    }

    .section-title {
      font-size: 18px;
      margin-top: 25px;
      font-weight: 600;
      color: #148c9e;
    }
  </style>
</head>

<body>

  <div class="receipt-card container ">

    <!-- Logo -->
    <div class="d-flex justify-content-between align-items-center mb-4 ">
<img src="<%= logo %>" style="width:120px; margin-bottom:20px;" />
       <h2 class="brand-color mb-0 ">Order Receipt</h2>
    </div>

    <!-- Order info -->
    <div class="mb-3">
      <p class="mb-1"><strong>Order ID:</strong> <%= order._id %></p>
      <p class="mb-1"><strong>Transaction ID:</strong> <%= order.transactionId %></p>
      <p class="mb-1"><strong>Date:</strong> <%= order.createdAt.toDateString() %></p>
    </div>

    <!-- Customer -->
    <div class="section-title">Customer Details</div>
    <div>
      <p class="mb-1"><strong>Name:</strong> <%= order.user.fullName %></p>
      <p class="mb-1"><strong>Email:</strong> <%= order.user.email %></p>
      <p class="mb-1"><strong>Contact:</strong> <%= `${order.user.countryCode } ${order.user.contactNumber }` %></p>
    </div>

    <!-- Items -->
    <div class="section-title">Purchased Courses</div>

    <table class="table table-bordered mt-2">
      <thead>
        <tr>
          <th>Course</th>
          <th style="width: 25%">Author</th>
          <th style="width: 20%" class="text-end">Price</th>
        </tr>
      </thead>

      <tbody>
        <% order.items.forEach(item => { %>
          <tr>
            <td><%= item.name %></td>
            <td><%= item.author %></td>
            <td class="text-end">₹ <%= item.price.toFixed(2) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <!-- Totals -->
    <div class="section-title">Payment Summary</div>

    <table class="table">
      <tbody>
        <tr>
          <td class="text-end"><strong>Subtotal:</strong></td>
          <td class="text-end">₹ <%= order.subTotal.toFixed(2) %></td>
        </tr>

        <tr>
          <td class="text-end"><strong>Discount:</strong></td>
          <td class="text-end text-success">- ₹ <%= order.discount.toFixed(2) %></td>
        </tr>

        <tr class="total-row">
          <td class="text-end"><span>Total Amount:</span></td>
          <td class="text-end brand-color">₹ <%= order.totalAmount.toFixed(2) %></td>
        </tr>
      </tbody>
    </table>

    <div class="text-center mt-4">
      <p class="mb-1 brand-color" style="font-weight: 600;">
        Thank you for learning with BrainElavate!
      </p>
      <p class="text-muted">This is a system-generated receipt.</p>
    </div>

  </div>

</body>
</html>
