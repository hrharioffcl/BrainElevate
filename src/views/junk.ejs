                    'https://restcountries.com/v3.1/all?fields=name,idd'









                    
<script>
    const savedCountryCode = "<%= user.countryCode || (formData && formData.countryCode) || '' %>";
</script>


<script>
    document.addEventListener("DOMContentLoaded", () => {
        const selectCountry = document.querySelector('#codes');

        fetch('https://restcountries.com/v3.1/all?fields=name,idd')
            .then(res => res.json())
            .then(data => {

                data.forEach(country => {
                    if (!country.idd || !country.idd.root) return;

                    const root = country.idd.root;
                    const suffix = country.idd.suffixes?.[0] || "";
                    const fullCode = root + suffix; // example "+91"

                    const option = document.createElement("option");

                    option.value = fullCode  // sets "91"
                    option.setAttribute("data-code", fullCode);  // store "+91"
                  
                });

                // 🔥 After appending options, set selected value
                if (savedCountryCode) {
                    selectCountry.value = savedCountryCode;
                }
                const phoneInput = document.querySelector('input[name="phone"]');

selectCountry.addEventListener("change", () => {
    const selected = selectCountry.options[selectCountry.selectedIndex];
    const dialCode = selected.getAttribute("data-code");

    if (!phoneInput.value.startsWith(dialCode)) {
        phoneInput.value = dialCode + " ";
    }
});

            })
            

 .catch(err => console.error(err));
    });
</script>