<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.fullName %> | My Learning</title>

  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/profile.css">

  <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">


</head>

<body>

  <!-- HEADER -->
  <%- include('partials/header') %>

  <!-- PROFILE TABS -->
  <%- include('partials/profileTabs', { activeTab: 'mylearning' }) %>

<section class="learning-cart">
 <div class="cart-container  my-4 ">


    <!-- PAGE TITLE -->
    <h2 class="mylearning-section-title">My Learning</h2>
    <hr>

    <!-- PROGRESS / COMPLETED SWITCH -->
    <div class="d-flex gap-2 mb-4">
      <a href="/profile/<%= user.fullName %>/mylearning?view=inprogress"
        class="mylearning-tab-btn <%= view === 'completed' ? 'mylearning-tab-inactive' : 'mylearning-tab-active' %>">
        In Progress
      </a>

      <a href="/profile/<%= user.fullName %>/mylearning?view=completed"
        class="mylearning-tab-btn <%= view === 'completed' ? 'mylearning-tab-active' : 'mylearning-tab-inactive' %>">
        Completed
      </a>
    </div>

    <% 
      let list = view === 'completed' ? completedCourses : inProgressCourses; 
    %>

    <!-- SECTION TITLE -->
    <h5 class="mb-3">
      <%= view === 'completed' ? 'Completed Courses' : 'In Progress Courses' %> 
      (<%= list.length %>)
    </h5>

    <!-- COURSES GRID -->
    <div class="row g-4">
      <% if(list.length === 0) { %>
        <div class="col-12 text-center text-muted py-5">
          No Completed Courses
        </div>
      <% } %>

      <% list.forEach(course => { %>

        <div class="col-md-3 col-sm-6">
          <div class="mylearning-course-card">

            <!-- IMAGE -->
              <a href="/profile/<%= user.fullName %>/mylearning/<%= course.slug %>/<%= course.eid %>"><img src="<%= course.thumbnail.url %>" class="mylearning-course-img" alt="Course thumbnail">
</a> 
            <!-- CONTENT -->
            <div class="mylearning-course-body">
             <a href="/profile/<%= user.fullName %>/mylearning/<%= course.slug %>/<%= course.eid %>" class="text-decoration-none text-dark"> <h6 class="fw-bold mb-1 "><%= course.title %></h6></a>

              <p class="small text-muted mb-1">
                <%= course.instructor %>
              </p>

              <p class="small text-muted mb-1">
                Course progress
              </p>

              <!-- PROGRESS BAR -->
              <div class="mylearning-progress mb-1">
                <div class="progress-bar" 
                     role="progressbar"
                     style="width: <%= course.progress %>">
                </div>
              </div>

              <p class="small text-muted">
                <%= course.progress %>%
              </p>
            </div>

          </div>
        </div>

      <% }) %>
    </div>

  </div>
</section>


  <!-- FOOTER -->
  <%- include('partials/footer') %>

</body>

</html>
