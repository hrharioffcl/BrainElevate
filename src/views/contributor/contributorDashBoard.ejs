<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Super Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex" style="background-color: rgb(0, 0, 0);">

  <!-- Sidebar -->
  <%- include("../partials/contributorSideBar") %>
<!-- Main Content -->
<div class="main-content flex-grow-1 p-4">
  <h4>Contributor Dashboard</h4>
  <p>Manage your courses and track approval status</p>

  <!-- Stats -->
  <div class="row mb-4">

    <div class="col-md-3">
      <div class="card text-center p-3 shadow-sm border">
        Total Courses
        <h3>12</h3>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-center p-3 shadow-sm border">
        Pending Approval
        <h3>4</h3>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-center p-3 shadow-sm border">
        Published Courses
        <h3>7</h3>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-center p-3 shadow-sm border">
        Rejected Courses
        <h3>1</h3>
      </div>
    </div>

  </div>

  <!-- Recent Course Activity -->
  <div class="card p-4 shadow-sm mb-4">
    <h5 class="mb-3">Recent Course Activity</h5>

    <table class="table">
      <thead>
        <tr>
          <th>Course</th>
          <th>Status</th>
          <th>Last Updated</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td>Node.js Masterclass</td>
          <td>
            <span class="badge bg-warning text-dark">
              Pending
            </span>
          </td>
          <td>Today</td>
        </tr>

        <tr>
          <td>JavaScript Fundamentals</td>
          <td>
            <span class="badge bg-success">
              Published
            </span>
          </td>
          <td>2 Days Ago</td>
        </tr>

        <tr>
          <td>MongoDB Bootcamp</td>
          <td>
            <span class="badge bg-danger">
              Rejected
            </span>
          </td>
          <td>5 Days Ago</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Quick Actions -->
  <div class="card p-4 shadow-sm">
    <h5 class="mb-3">Quick Actions</h5>

    <div class="d-flex gap-3 flex-wrap">

      <a href="/admin/addnewcourse"
         class="btn btn-primary">
        <i class="bi bi-plus-circle"></i>
        Add New Course
      </a>

      <a href="/admin/my-courses"
         class="btn btn-outline-light">
        <i class="bi bi-journal-bookmark"></i>
        My Courses
      </a>

      <a href="/admin/pending-courses"
         class="btn btn-outline-warning">
        <i class="bi bi-hourglass-split"></i>
        Pending Approval
      </a>

    </div>
  </div>

</div>

</body>



</html>
