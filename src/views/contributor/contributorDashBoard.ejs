<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contributer Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex" style="background-color: rgb(0, 0, 0);">

  <!-- Sidebar -->
  <%- include("../partials/contributorSideBar") %>
<!-- Main Content -->
<div class="main-content flex-grow-1 p-4">
  <h4>Contributor Dashboard</h4>
  <p>Manage your courses and track approval status</p>

<!-- Stats -->
<div class="row mb-4">

  <div class="col-md-3">
    <div class="card text-center p-3 shadow-sm border">
      Total Courses
      <h3><%= totalCourses %></h3>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card text-center p-3 shadow-sm border">
      Pending Approval
      <h3><%= pendingCourses %></h3>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card text-center p-3 shadow-sm border">
      Published Courses
      <h3><%= publishedCourses %></h3>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card text-center p-3 shadow-sm border">
      Rejected Courses
      <h3><%= rejectedCourses %></h3>
    </div>
  </div>

</div>

  <!-- Recent Course Activity -->
  <div class="card p-4 shadow-sm mb-4">
    <h5 class="mb-3">Recent Course Activity</h5>

    <table class="table">
      <thead>
        <tr>
          <th>Course</th>
          <th>Status</th>
          <th>Last Updated</th>
        </tr>
      </thead>
<tbody>

<% if(recentCourses.length > 0){ %>

    <% recentCourses.forEach(course => { %>

    <tr>
        <td><%= course.name %></td>

        <td>

            <% if(course.status === "pending"){ %>

                <span class="badge bg-warning text-dark">
                    Pending
                </span>

            <% } else if(course.status === "approved" || course.status === "published"){ %>

                <span class="badge bg-success">
                    Approved
                </span>

            <% } else if(course.status === "rejected"){ %>

                <span class="badge bg-danger">
                    Rejected
                </span>

            <% } else { %>

                <span class="badge bg-secondary">
                    Draft
                </span>

            <% } %>

        </td>

        <td>
            <%= new Date(course.updatedAt).toLocaleDateString() %>
        </td>
    </tr>

    <% }) %>

<% } else { %>

    <tr>
        <td colspan="3" class="text-center">
            No activity found
        </td>
    </tr>

<% } %>

</tbody>
    </table>
  </div>


</div>
<%- include("../partials/flashalerts") %>

</body>



</html>
